{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "cerebras-cli",
  "version": "1.0.145",
  "description": "AI-powered coding assistant CLI with Cerebras fast inference",
  "author": "Kevin Taylor",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "./script/build.ts",
    "dev": "bun run --conditions=browser ./src/index.ts"
  },
  "bin": {
    "cerebras-cli": "./bin/opencode.cjs"
  },
  "keywords": [
    "cli",
    "ai",
    "coding",
    "assistant",
    "llm",
    "cerebras",
    "code-generation",
    "developer-tools",
    "terminal",
    "tui",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevint-cerebras/cerebras-code-cli.git",
    "directory": "packages/opencode"
  },
  "bugs": {
    "url": "https://github.com/kevint-cerebras/cerebras-code-cli/issues"
  },
  "homepage": "https://github.com/kevint-cerebras/cerebras-code-cli#readme",
  "optionalDependencies": {
    "cerebras-cli-darwin-arm64": "1.0.5"
  }
}
